<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudentApp.ViewModels"
			 xmlns:data="clr-namespace:StudentApp.Data;assembly=StudentApp.Data"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudentApp.Views.MainView"
             x:DataType="vm:MainViewModel">
	<Grid RowDefinitions="Auto,*">
		<TextBlock Text="Картинг-центр: Панель управления" FontSize="20" FontWeight="Bold" Margin="10" Grid.Row="0"/>

		<TabControl Grid.Row="1" Margin="10">

			<TabItem Header="Клиенты">
				<ListBox x:Name="ClientsList">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Client">
							<TextBlock Text="{Binding}" Margin="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</TabItem>

			<TabItem Header="Карты">
				<ListBox x:Name="KartsList">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Kart">
							<TextBlock Text="{Binding}" Margin="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</TabItem>

			<TabItem Header="Заезды">
				<ListBox x:Name="RacesList">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="data:Race">
							<TextBlock Text="{Binding}" Margin="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</TabItem>

		</TabControl>
	</Grid>
</UserControl>